# Vercel AI Gateway — create a key at https://vercel.com/d?to=/[team]/~/ai
# On Vercel deployments, OIDC auth is used automatically (run `vercel env pull` locally).
AI_GATEWAY_API_KEY=
# Optional model overrides (any AI Gateway model id)
AI_MODEL=anthropic/claude-haiku-4.5
AI_MODEL_EXTRACT=openai/gpt-4.1
AI_MODEL_FAST=openai/gpt-4.1-mini

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never expose to the browser
SUPABASE_SECRET_KEY=

# Firecrawl — website crawl + company research (https://firecrawl.dev)
FIRECRAWL_API_KEY=
