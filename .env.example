# Vercel AI Gateway — create a key at https://vercel.com/d?to=/[team]/~/ai
# On Vercel deployments, OIDC auth is used automatically (run `vercel env pull` locally).
AI_GATEWAY_API_KEY=
# Optional: any AI Gateway model id
AI_MODEL=anthropic/claude-sonnet-4.5

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
